# Demo admin password (min 6 chars). Set the same variable in Netlify.
DEMO_ADMIN_PASSWORD=change-me-demo

# Public site address, used for absolute share-image links (Netlify sets URL itself).
# NEXT_PUBLIC_SITE_URL=https://example.org

# Launch switch: true opens robots.txt to search + AI crawlers and drops noindex.
# Only after the placeholder address, phone and content are replaced.
# NEXT_PUBLIC_SITE_INDEXABLE=true

# Analytics (nothing loads until set). Add both to the privacy policy first.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
